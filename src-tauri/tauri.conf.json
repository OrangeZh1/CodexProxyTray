{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodexProxyTray",
  "version": "0.2.7",
  "identifier": "com.orange.codexproxytray",
  "build": { "frontendDist": "../dist", "devUrl": "http://127.0.0.1:4173" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "CodexProxyTray", "width": 1080, "height": 820, "minWidth": 780, "minHeight": 660, "decorations": false, "visible": false, "backgroundColor": "#1b2029" },
      { "label": "tray", "title": "CodexProxyTray · 托盘菜单", "url": "tray.html", "width": 272, "height": 380, "decorations": false, "transparent": true, "shadow": false, "resizable": false, "maximizable": false, "minimizable": false, "alwaysOnTop": true, "skipTaskbar": true, "visible": false, "focus": false, "backgroundColor": "#00000000" }
    ],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: data:" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico", "icons/icon.png"] }
}
