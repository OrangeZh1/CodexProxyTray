{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodexProxyTray",
  "version": "0.1.0",
  "identifier": "com.orange.codexproxytray",
  "build": { "frontendDist": "../dist", "devUrl": "http://127.0.0.1:4173" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "CodexProxyTray", "width": 1080, "height": 820, "minWidth": 780, "minHeight": 660, "scrollBarStyle": "fluentOverlay", "decorations": false, "visible": false, "backgroundColor": "#1b2029" }],
    "security": { "headers": { "Cache-Control": "no-store" }, "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: data:" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico", "icons/icon.png"] }
}
